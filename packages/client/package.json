{
  "name": "@porterkit/client",
  "version": "0.0.0",
  "description": "Porter's client: login, connection and state, for any Binding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sifawm/porterkit",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@porterkit/contracts": "workspace:*"
  }
}
